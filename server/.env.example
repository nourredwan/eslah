# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL
# Replace with your local PostgreSQL or cloud provider (e.g. Supabase, Neon, Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/community_reports?schema=public"

# JWT Authentication Security (Use a long random string in production)
JWT_SECRET=super_secret_jwt_encryption_key_community_platform_2026_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Configuration for Image/Media Storage
# Get your credentials at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
